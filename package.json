{
  "name": "@react-hive/honey-hooks",
  "version": "3.2.0",
  "description": "React hooks for mouse and touch dragging, synthetic scrolling with inertia, drop zones, requestAnimationFrame loops and timers, plus key and resize listeners, stable latest-value refs and object URLs that revoke themselves.",
  "keywords": [
    "react",
    "hooks",
    "react-hooks",
    "drag",
    "touch",
    "drag-and-drop",
    "synthetic-scroll",
    "inertia",
    "requestanimationframe",
    "timer",
    "resize",
    "keyboard",
    "object-url",
    "typescript",
    "react-hive"
  ],
  "bugs": {
    "url": "https://github.com/React-Hive/honey-hooks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/React-Hive/honey-hooks.git"
  },
  "author": "Mike Aliinyk <m.aliynik@gmail.com>",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf dist coverage",
    "test": "vitest",
    "build": "webpack --config webpack.config.mjs",
    "prepublishOnly": "CI=1 pnpm clean && pnpm test && pnpm build"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/__mocks__",
    "!dist/**/__tests__"
  ],
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@react-hive/honey-utils": "4.2.0",
    "csstype": "3.2.3",
    "lodash.throttle": "4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/lodash.throttle": "4.1.9",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "copy-webpack-plugin": "14.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react": "7.37.5",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3"
  }
}
